# =============================================================================
# infra/kubernetes/secrets/secrets.yaml.example
#
# TEMPLATE ONLY. Every value below is a placeholder, not a real secret.
#
# DO NOT populate this file in place and commit it. Instead:
#
#   cp infra/kubernetes/secrets/secrets.yaml.example \
#      infra/kubernetes/secrets/secrets.yaml
#   # then edit secrets.yaml with real values
#
# infra/kubernetes/secrets/secrets.yaml (the real file) is covered by
# .gitignore and must never be committed. This template is the only
# file in that directory that IS committed (see the .gitignore
# exception immediately above the ignore rule for this directory).
#
# Keys below are the complete, authoritative set actually referenced
# by name across every Deployment/Job/StatefulSet in infra/kubernetes/
# (auth-service, ai-service, worker, postgres-statefulset, auth-migrate,
# ai-migrate) - confirmed by grepping every secretKeyRef in this repo,
# not assumed. Do not rename these keys without updating every
# manifest that references them.
# =============================================================================

apiVersion: v1
kind: Secret

metadata:
  name: medmatch-secrets
  namespace: medmatch
  labels:
    app: medmatch
    component: secrets
    environment: production

# `stringData` (plain text here) is used only for template readability.
# Kubernetes converts stringData to base64-encoded `data` on apply;
# this is not itself an encryption mechanism - a plain Kubernetes
# Secret is base64-encoded, not encrypted, at rest unless the cluster
# has encryption-at-rest configured separately. For anything beyond
# local/dev use, prefer a real secret-management tool (Sealed Secrets,
# External Secrets Operator, or your cloud provider's secret manager)
# layered on top of this same key structure - this repo does not
# currently use any of those, so this plain-Secret template matches
# what infra/scripts/deploy.sh and docs/runbooks/production-deployment.md
# already assume (`kubectl apply -f secrets.yaml`).
stringData:
  # --- Database (used by: postgres-statefulset, auth-service,
  # auth-migrate, ai-service, ai-migrate, worker) ---
  DATABASE_USERNAME: "REPLACE_ME_DATABASE_USERNAME"
  DATABASE_PASSWORD: "REPLACE_ME_DATABASE_PASSWORD"

  # Single pre-composed connection string used by ai-service, ai-migrate,
  # and worker (they read DATABASE_URL directly, not separate
  # username/password keys - preserve this design, do not split it).
  # Must be kept consistent with DATABASE_USERNAME/DATABASE_PASSWORD
  # above and with postgres-service's host/port/db name.
  DATABASE_URL: "postgresql://REPLACE_ME_DATABASE_USERNAME:REPLACE_ME_DATABASE_PASSWORD@postgres-service.medmatch.svc.cluster.local:5432/medmatch"

  # --- LLM (used by: ai-service, ai-migrate is NOT actually required
  # to call the LLM, but the key is present in that Job's env today -
  # see final report) ---
  LLM_API_KEY: "REPLACE_ME_GEMINI_API_KEY"

  # --- JWT (used by: auth-service signs with the private key,
  # mounted as a file via the jwt-keys volume; ai-service and worker
  # only ever receive the public key, as an env var, to verify tokens -
  # preserve this asymmetry, never give ai-service/worker the private key) ---
  JWT_PRIVATE_KEY: |
    REPLACE_ME_WITH_REAL_RSA_PRIVATE_KEY_PEM_CONTENTS
  JWT_PUBLIC_KEY: |
    REPLACE_ME_WITH_REAL_RSA_PUBLIC_KEY_PEM_CONTENTS
