# ==============================================================================
# MedMatch V2 — Environment Configuration Example (.env.example)
#
# Copy this file to .env and configure values appropriate for your environment.
# NEVER commit .env containing actual secrets, passwords, or production API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL + pgvector
# ------------------------------------------------------------------------------
POSTGRES_DB=medmatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_placeholder
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_placeholder@postgres:5432/medmatch

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Standard Redis URL format: redis://[:password@]host:port/db
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Celery & Asynchronous Task Processing
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Gemini API & LLM Service
# ------------------------------------------------------------------------------
# Required for unstructured eligibility reasoning and criteria parsing
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# JWT Authentication & Cryptographic Keys (RS256)
# ------------------------------------------------------------------------------
# Path to the RSA 2048-bit public key used by AI service to verify auth tokens
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
# Path to the RSA 2048-bit private key used by Auth service to sign auth tokens
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem

# ------------------------------------------------------------------------------
# Service Ports & External URLs
# ------------------------------------------------------------------------------
AUTH_SERVICE_PORT=8081
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_BASE_URL=http://localhost:8081
